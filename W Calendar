function renderMain(){
  const main = $('#main');
  const ae = document.activeElement;
  const fid = (ae && ae.id && ['addtext', 'addwho', 'impbox'].indexOf(ae.id) >= 0) ? ae.id : null;
  const range = fid ? [ae.selectionStart, ae.selectionEnd] : null;
  if (state.tab === 'cal'){
    const old = $('#panel');
    const sc = old ? old.scrollTop : 0;
    main.innerHTML = '<div class="layout"><section aria-label="Calendar">' + renderCal() + '</section><aside class="panel' + (state.overlay ? ' open' : '') + '" id="panel" aria-label="दिवसाचा तपशील">' + renderPanelHTML() + '</aside></div>';
    const np = $('#panel'); if (np) np.scrollTop = sc;
  } else if (state.tab === 'work') main.innerHTML = renderWork();
  else if (state.tab === 'fest') main.innerHTML = renderFest();
  else main.innerHTML = renderPlan();
  if (fid){
    const el = document.getElementById(fid);
    if (el){ el.focus(); try { el.setSelectionRange(range[0], range[1]); } catch(e){} }
  }
}
function renderAll(){ renderStats(); renderTabs(); renderFilters(); renderMain(); }

/* ---------- actions ---------- */
let toastT = null;
function toast(msg){
  const t = $('#toast'); t.textContent = msg; t.classList.add('show');
  clearTimeout(toastT); toastT = setTimeout(() => t.classList.remove('show'), 1600);
}
function fallbackCopy(text){
  const ta = document.createElement('textarea');
  ta.value = text; ta.setAttribute('readonly', ''); ta.style.position = 'fixed'; ta.style.opacity = '0';
  document.body.appendChild(ta); ta.select();
  let ok = false; try { ok = document.execCommand('copy'); } catch(e){}
  ta.remove(); return ok;
}
function copyText(text){
  if (navigator.clipboard && navigator.clipboard.writeText){
    return navigator.clipboard.writeText(text).then(() => true).catch(() => fallbackCopy(text));
  }
  return Promise.resolve(fallbackCopy(text));
}
function mobile(){ return window.matchMedia('(max-width:1039px)').matches; }
function selectDate(d){
  state.sel = d; resetOpen();
  if (mobile()){ state.overlay = true; document.body.classList.add('lock'); }
  renderMain();
}
function closeOverlay(){
  state.overlay = false; document.body.classList.remove('lock');
  const p = $('#panel'); if (p) p.classList.remove('open');
}

function enc(str){
  const bytes = new TextEncoder().encode(str); let bin = '';
  bytes.forEach(x => { bin += String.fromCharCode(x); });
  return btoa(bin);
}
function dec(str){
  const bin = atob(str);
  return new TextDecoder().decode(Uint8Array.from(bin, c => c.charCodeAt(0)));
}
function addTask(){
  const text = (state.draft.text || '').trim().slice(0, 200);
  if (!text){ toast('आधी task लिहा'); return; }
  const id = 'u' + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
  const post = state.draft.post || '';
  const t = { id:id, date:state.sel, text:text, who:(state.draft.who || '').trim().slice(0, 40), post:post, acct:post ? '' : (state.draft.acct || '') };
  state.draft.text = ''; state.draft.who = ''; state.addOpen = true;
  if (DBREF){
    customDb[id] = t;
    DBREF.doc('custom/' + id).set(t).catch(() => {
      delete customDb[id]; customLocal.push(t); saveCustom();
      toast('Shared save झालं नाही — हे task फक्त या device वर save केलं'); renderAll();
    });
  } else { customLocal.push(t); saveCustom(); }
  renderAll(); toast('Task add झालं');
}
function delTask(id){
  customLocal = customLocal.filter(t => t.id !== id); saveCustom();
  if (customDb[id]){
    delete customDb[id];
    if (DBREF) DBREF.doc('custom/' + id).delete().catch(() => {});
  }
  renderAll();
}
function exportCode(){
  const doneIds = allTasks().filter(t => isDone(t.id)).map(t => t.id);
  const code = 'BESKSWAB1:' + enc(JSON.stringify({ v:1, custom:customTasks(), done:doneIds }));
  state.exportCode = code;
  copyText(code).then(ok => toast(ok ? 'Code copy झाला — WhatsApp वर पाठवा' : 'खालचा code select करून copy करा'));
  renderAll();
}
function importCode(){
  const raw = (state.impText || '').replace(/\s+/g, '');
  const pre = 'BESKSWAB1:';
  if (raw.indexOf(pre) !== 0){ toast('Code बरोबर नाही'); return; }
  let o;
  try { o = JSON.parse(dec(raw.slice(pre.length))); } catch(e){ toast('Code वाचता आला नाही'); return; }
  const known = {};
  TASKS.forEach(t => { known[t.id] = true; });
  const have = {};
  customTasks().forEach(t => { have[t.id] = true; });
  let nc = 0, nd = 0;
  (Array.isArray(o.custom) ? o.custom : []).forEach(t => {
    if (!t || typeof t.id !== 'string' || !/^u[a-z0-9]{3,30}$/.test(t.id) || have[t.id]) return;
    if (typeof t.date !== 'string' || !/^\d{4}-\d{2}-\d{2}$/.test(t.date) || typeof t.text !== 'string' || !t.text.trim()) return;
    customLocal.push({ id:t.id, date:t.date, text:t.text.slice(0, 200), who:String(t.who || '').slice(0, 40), post:POST_BY_ID[t.post] ? t.post : '', acct:(t.acct === 'besk' || t.acct === 'swab') ? t.acct : '' });
    known[t.id] = true; have[t.id] = true; nc++;
  });
  (Array.isArray(o.done) ? o.done : []).forEach(id => {
    if (typeof id === 'string' && known[id] && !isDone(id)){ setDone(id, true); nd++; }
  });
  saveCustom(); state.impText = '';
  renderAll(); toast(nc + ' नवीन task आणि ' + nd + ' पूर्ण कामं import झाली');
}

document.addEventListener('click', e => {
  const el = e.target.closest('[data-tab],[data-date],[data-acct],[data-copykey],[data-close],[data-open],[data-pending],[data-theme],[data-addtask],[data-deltask],[data-export],[data-import]');
  if (!el) return;
  if (el.dataset.tab){ state.tab = el.dataset.tab; closeOverlay(); renderAll(); return; }
  if (el.dataset.date){ selectDate(el.dataset.date); return; }
  if (el.dataset.acct){ state.acct = el.dataset.acct; resetOpen(); renderAll(); return; }
  if (el.dataset.copykey){
    copyText(COPY[el.dataset.copykey] || '').then(ok => toast(ok ? 'Copy झालं' : 'Copy होऊ शकलं नाही — text select करून copy करा'));
    return;
  }
  if (el.dataset.close){ closeOverlay(); return; }
  if (el.dataset.open){ state.tab = 'cal'; state.sel = el.dataset.open; resetOpen(); if (mobile()){ state.overlay = true; document.body.classList.add('lock'); } renderAll(); window.scrollTo(0, 0); return; }
  if (el.dataset.pending){ state.pending = !state.pending; renderAll(); return; }
  if (el.dataset.addtask){ addTask(); return; }
  if (el.dataset.deltask){ delTask(el.dataset.deltask); return; }
  if (el.dataset.export){ exportCode(); return; }
  if (el.dataset.import){ importCode(); return; }
  if (el.dataset.theme){
    const root = document.documentElement;
    const dark = root.dataset.theme ? root.dataset.theme === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
    root.dataset.theme = dark ? 'light' : 'dark';
    return;
  }
});
document.addEventListener('input', e => {
  const t = e.target;
  if (t.id === 'addtext') state.draft.text = t.value;
  else if (t.id === 'addwho') state.draft.who = t.value;
  else if (t.id === 'impbox') state.impText = t.value;
});
document.addEventListener('change', e => {
  const t = e.target;
  if (t.id === 'addacct'){ state.draft.acct = t.value; return; }
  if (t.id === 'addpost'){ state.draft.post = t.value; return; }
  const c = t.closest && t.closest('input[data-task]');
  if (!c) return;
  setDone(c.dataset.task, c.checked);
  renderAll();
});
document.addEventListener('toggle', e => {
  const d = e.target;
  if (!d || !d.matches) return;
  if (d.matches('details[data-p]')){
    if (d.open) state.open.add(d.dataset.p); else state.open.delete(d.dataset.p);
  } else if (d.matches('details[data-add]')){
    state.addOpen = d.open;
  }
}, true);
document.addEventListener('focusin', e => { if (e.target && e.target.dataset && e.target.dataset.selectall) e.target.select(); });
document.addEventListener('keydown', e => {
  if (e.key === 'Escape' && state.overlay) closeOverlay();
  if (e.key === 'Enter' && e.target && e.target.id === 'addtext'){ e.preventDefault(); addTask(); }
});

resetOpen();
renderAll();
initDb();
})();
</script>
</body>
</html>
