try { localDone = JSON.parse(localStorage.getItem(LS_KEY) || '{}') || {}; } catch(e){ localDone = {}; }
const dbDone = {};
let DBREF = null;
const wq = {};

const LS_CUSTOM = 'besk-swab-nov26-custom-v1';
let customLocal = [];
try { customLocal = JSON.parse(localStorage.getItem(LS_CUSTOM) || '[]') || []; } catch(e){ customLocal = []; }
const customDb = {};
let storageOK = true;
try { localStorage.setItem('__t', '1'); localStorage.removeItem('__t'); } catch(e){ storageOK = false; }
function saveCustom(){ try { localStorage.setItem(LS_CUSTOM, JSON.stringify(customLocal)); } catch(e){} }
function customTasks(){
  const m = {};
  customLocal.forEach(t => { if (t && t.id) m[t.id] = t; });
  Object.keys(customDb).forEach(k => { m[k] = customDb[k]; });
  return Object.keys(m).map(k => m[k]).filter(t => t && t.date && t.text);
}
function tasksOn(d){ const S = DATES[d]; return (S ? S.tasks : []).concat(customTasks().filter(t => t.date === d)); }
function allTasks(){ return TASKS.concat(customTasks()); }
function taskAcct(t){ if (t.post && POST_BY_ID[t.post]) return POST_BY_ID[t.post].acct; return t.acct || ''; }
function visT(t){ const a = taskAcct(t); return state.acct === 'all' || !a || a === state.acct; }
function isCustom(t){ return String(t.id).charAt(0) === 'u'; }

function saveLocal(){ try { localStorage.setItem(LS_KEY, JSON.stringify(localDone)); } catch(e){} }
function isDone(id){ return (id in dbDone) ? dbDone[id] : !!localDone[id]; }
function setDone(id, v){
  localDone[id] = v; saveLocal();
  if (DBREF){
    dbDone[id] = v;
    wq[id] = (wq[id] || Promise.resolve())
      .then(() => DBREF.doc('progress/' + id).set({ done: v }))
      .catch(() => { delete dbDone[id]; renderAll(); });
  }
}
async function initDb(){
  try {
    if (!window.claude || !window.claude.use) return;
    const db = await window.claude.use('db');
    if (!db) return;
    DBREF = db;
    db.collection('progress').onSnapshot(snap => {
      Object.keys(dbDone).forEach(k => { delete dbDone[k]; });
      snap.docs.forEach(d => { const v = d.data(); if (v) dbDone[d.id] = !!v.done; });
      renderAll();
    }, () => {});
    db.collection('custom').onSnapshot(snap => {
      Object.keys(customDb).forEach(k => { delete customDb[k]; });
      snap.docs.forEach(d => { const v = d.data(); if (v && v.date && v.text) customDb[d.id] = Object.assign({}, v, { id:d.id }); });
      renderAll();
    }, () => {});
  } catch(e){}
}

const state = { tab:'cal', acct:'all', sel:null, pending:false, overlay:false, open:new Set(), draft:{ text:'', who:'', acct:'', post:'' }, addOpen:false, impText:'', exportCode:'' };
try { const h = (location.hash || '').slice(1); if (['cal','work','fest','plan'].indexOf(h) >= 0) state.tab = h; } catch(e){}

function vis(p){ return state.acct === 'all' || p.acct === state.acct; }
function defaultDate(){
  const keys = Object.keys(DATES).sort();
  for (let i = 0; i < keys.length; i++){ if (keys[i] >= TODAY) return keys[i]; }
  return '2026-11-01';
}
state.sel = defaultDate();

const COPY = {}; let cseq = 0;
function reg(text){ const k = 'c' + (++cseq); COPY[k] = text; return k; }

/* ---------- content builders ---------- */
function ctaOf(p){ return p.cta || (p.acct === 'besk' ? BESK_CTA : SWAB_CTA); }
function fullCaption(p){
  let c = p.caption;
  if (p.inc) c += '\n\n' + INC;
  c += '\n\n' + ctaOf(p);
  if (p.disc) c += '\n\n' + DISC;
  return c;
}
function scriptText(p){
  if (p.beats) return p.beats.map(b => '[' + b[0] + ']\nVisual: ' + b[1] + '\nOn-screen: ' + b[2] + '\nVoice: ' + b[3]).join('\n\n');
  return (p.slides || []).map((s, i) => 'Slide ' + (i + 1) + '\n' + s[0] + (s[1] ? '\n' + s[1] : '')).join('\n\n');
}
function fillCount(p){ const m = JSON.stringify(p).match(/\{\{/g); return m ? m.length : 0; }
function postTasks(p){ return TASKS.filter(t => t.post === p.id); }

function sec(title, inner, copyKey){
  return '<div class="sec"><div class="row"><h5>' + title + '</h5>' + (copyKey ? '<button class="cpy" data-copykey="' + copyKey + '">Copy</button>' : '') + '</div>' + inner + '</div>';
}
function contentHTML(p){
  let h = '';
  h += sec('Hook (पहिल्या 3 सेकंदात / Cover)', '<div class="hook">' + fill(p.hook) + '</div>');
  if (p.beats){
    const beats = p.beats.map(b =>
      '<div class="beat"><div class="tm">' + esc(b[0]) + '</div>' +
      '<div class="ln"><b>Visual</b>' + fill(b[1]) + '</div>' +
      '<div class="ln"><b>On-screen</b>' + fill(b[2]) + '</div>' +
      '<div class="ln"><b>Voice</b>' + fill(b[3]) + '</div></div>').join('');
    h += sec('Reel script', beats, reg(plain(scriptText(p))));
  } else {
    const label = p.fmt === 'poster' ? 'Poster text' : 'Slides (Carousel)';
    const slides = p.slides.map((s, i) =>
      '<div class="slide"><div class="n">' + (i + 1) + '</div><div><div class="h">' + fill(s[0]) + '</div>' +
      (s[1] ? '<div class="s">' + fill(s[1]) + '</div>' : '') + '</div></div>').join('');
    h += sec(label, slides, reg(plain(scriptText(p))));
  }
  h += sec('Caption', '<div class="txt">' + fill(fullCaption(p)) + '</div>', reg(plain(fullCaption(p))));
  h += sec('Hashtags (caption च्या शेवटी)', '<div class="txt">' + esc(p.tags) + '</div>', reg(p.tags));
  let kv = '<dl class="kv">';
  kv += '<dt>Goal</dt><dd>' + fill(p.goal) + '</dd>';
  kv += '<dt>Production</dt><dd>' + esc(PROD_LABEL[p.prod] || p.prod) + '</dd>';
  if (p.audio) kv += '<dt>Audio</dt><dd>' + fill(p.audio) + '</dd>';
  if (p.cover) kv += '<dt>Cover</dt><dd>' + fill(p.cover) + '</dd>';
  kv += '<dt>Design</dt><dd>' + fill(p.design) + '</dd>';
  if (p.notes) kv += '<dt>टीप</dt><dd>' + fill(p.notes) + '</dd>';
  const tl = postTasks(p).map(t => dshort(t.date) + ' ' + TL[t.k] + (isDone(t.id) ? ' ✓' : '')).join(' → ');
  kv += '<dt>Timeline</dt><dd>' + esc(tl) + '</dd>';
  kv += '</dl>';
  h += sec('Brief', kv);
  return h;
}

function tagsHTML(p, d){
  let t = '<span class="tag ' + p.acct + '">' + AC[p.acct].n + '</span>';
  t += '<span class="tag">' + FM[p.fmt].l + '</span>';
  t += '<span class="tag">' + esc(p.offer) + '</span>';
  t += '<span class="tag">' + esc(p.pillar) + '</span>';
  if (p.date === d) t += '<span class="tag live">आज Live</span>';
  else t += '<span class="tag">Post: ' + dlabel(p.date).split(',')[1].trim() + '</span>';
  const n = fillCount(p);
  if (n) t += '<span class="tag fill">' + n + ' fill-in</span>';
  return t;
}
function taskRow(t){
  const done = isDone(t.id);
  return '<li class="' + (done ? 'done' : '') + '"><label><input type="checkbox" data-task="' + esc(t.id) + '"' + (done ? ' checked' : '') + '><span class="tt">' + esc(t.text) + '</span></label>' +
    (t.who ? '<span class="role">' + esc(t.who) + '</span>' : '') +
    (isCustom(t) ? '<button class="delt" data-deltask="' + esc(t.id) + '" aria-label="Task काढा">✕</button>' : '') + '</li>';
}
function postBlock(p, d, tasks){
  const isOpen = state.open.has(p.id);
  return '<article class="pb ' + p.acct + '"><div class="pbh"><div class="tags">' + tagsHTML(p, d) + '</div><h4>' + esc(p.title) + '</h4></div>' +
    '<ul class="tasks">' + tasks.map(taskRow).join('') + '</ul>' +
    '<details class="ct" data-p="' + p.id + '"' + (isOpen ? ' open' : '') + '><summary>Content (Script, Caption, Hashtags, Brief)</summary><div class="cbody">' + contentHTML(p) + '</div></details></article>';
}
function idsForDate(d){
  const S = DATES[d] || { posts:[], tasks:[] };
  const ids = [];
  S.posts.filter(vis).forEach(p => { if (ids.indexOf(p.id) < 0) ids.push(p.id); });
  const others = [];
  tasksOn(d).filter(visT).forEach(t => { if (t.post && POST_BY_ID[t.post] && ids.indexOf(t.post) < 0 && others.indexOf(t.post) < 0) others.push(t.post); });
  others.sort((a, b) => POST_BY_ID[a].date < POST_BY_ID[b].date ? -1 : 1);
  return ids.concat(others);
}
function resetOpen(){
  state.open = new Set();
  state.draft.post = '';
  idsForDate(state.sel).slice(0, 2).forEach(id => state.open.add(id));
}

/* ---------- renderers ---------- */
function renderStats(){
  const posts = POSTS.filter(vis);
  const tasks = allTasks().filter(visT);
  const done = tasks.filter(t => isDone(t.id)).length;
  const nb = posts.filter(p => p.acct === 'besk').length, ns = posts.filter(p => p.acct === 'swab').length;
  const pct = tasks.length ? Math.round(done * 100 / tasks.length) : 0;
  $('#stats').innerHTML =
    '<span class="stat"><b>' + posts.length + '</b> posts' + (state.acct === 'all' ? ' (BeSK ' + nb + ' · Swab ' + ns + ')' : '') + '</span>' +
    '<span class="stat"><b>' + done + '/' + tasks.length + '</b> कामं पूर्ण<span class="bar"><i style="width:' + pct + '%"></i></span></span>' +
    (!storageOK && !DBREF ? '<span class="stat">⚠ हा browser progress save करत नाही — Work list मधून Export करून ठेवा</span>' : '') +
    '<button class="iconbtn" data-theme="1" aria-label="Theme बदला">Light / Dark</button>';
}
function renderTabs(){
  $$('#tabs .tab').forEach(b => b.setAttribute('aria-selected', b.dataset.tab === state.tab ? 'true' : 'false'));
}
function renderFilters(){
  const f = $('#filters');
  if (state.tab === 'plan' || state.tab === 'fest'){ f.innerHTML = ''; return; }
  let h = '';
  [['all','सर्व'],['besk','BeSK'],['swab','Swab']].forEach(a => {
    h += '<button class="fbtn" data-acct="' + a[0] + '" aria-pressed="' + (state.acct === a[0]) + '">' +
      (a[0] === 'besk' ? '<span class="dot besk"></span>' : a[0] === 'swab' ? '<span class="dot swab"></span>' : '') + a[1] + '</button>';
  });
  if (state.tab === 'work') h += '<button class="fbtn" data-pending="1" aria-pressed="' + state.pending + '">फक्त pending</button>';
  f.innerHTML = h;
}

function renderCal(){
  let g = '<div class="cal" role="grid">';
  WDS.forEach(w => { g += '<div class="dow">' + w + '</div>'; });
  for (let d = GRID_START; d <= GRID_END; d = addDays(d, 1)){
    const dt = pd(d);
    const inMonth = d >= '2026-11-01' && d <= '2026-11-30';
    const S = DATES[d] || { posts:[], tasks:[] };
    const posts = S.posts.filter(vis);
    const tasks = tasksOn(d).filter(visT);
    const fe = FEST_BY[d] || [];
    const done = tasks.filter(t => isDone(t.id)).length;
    const label = (dt.getDate() === 1 || d === GRID_START) ? dt.getDate() + ' ' + MONS[dt.getMonth()] : String(dt.getDate());
    let cell = '<button class="cell' + (inMonth ? '' : ' out') + (d === state.sel ? ' sel' : '') + (d === TODAY ? ' today' : '') + '" data-date="' + d + '" aria-label="' + esc(dlabel(d)) + ': ' + posts.length + ' posts, ' + tasks.length + ' कामं">';
    cell += '<span class="dn">' + label + '</span>';
    fe.forEach(f => {
      const cls = f.a === 'Story' ? ' story' : f.a === 'Skip' ? ' skip' : '';
      cell += '<span class="fp' + cls + '">' + esc(f.n.replace(/\s*\(.*\)/, '')) + '</span>';
    });
    if (fe.length) cell += '<span class="fdot"></span>';
    posts.forEach(p => {
      cell += '<span class="chip ' + p.acct + (p.kind === 'fest' ? ' fest' : '') + '"><b>' + FM[p.fmt].c + '</b><i>' + esc(p.title) + '</i></span>';
    });
    if (tasks.length) cell += '<span class="cnt' + (done === tasks.length ? ' alldone' : '') + '">' + done + '/' + tasks.length + '</span>';
    cell += '</button>';
    g += cell;
  }
  g += '</div>';
  g += '<div class="legend"><span><b>R</b> Reel</span><span><b>C</b> Carousel</span><span><b>P</b> Poster</span>' +
    '<span><span class="dot besk"></span> BeSK (मराठी)</span><span><span class="dot swab"></span> Swab (English)</span>' +
    '<span>उजवा कोपरा: पूर्ण/एकूण कामं</span></div>';
  return g;
}

