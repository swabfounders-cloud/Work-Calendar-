<!DOCTYPE html>
<html lang="mr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>BeSK × Swab — नोव्हेंबर 2026 Content Calendar</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#FFFFFF; --bg2:#F4F6FA; --card:#FFFFFF; --ink:#031D41; --ink2:#4A5B76; --line:#E2E7F0;
  --bk:#F7931E; --bk-ink:#A85A00; --bk-bg:#FFF3E2; --bk-line:#FAD9A8;
  --sw:#4A3FF0; --sw-ink:#3A2FD0; --sw-bg:#EEF0FF; --sw-line:#CFD4FF;
  --gr:#0A8A47; --ok:#0A8A47; --warn-bg:#FFF1CC; --warn-ink:#7A4A00;
  --shadow:0 1px 2px rgba(3,29,65,.06),0 8px 24px rgba(3,29,65,.06);
  --grad:linear-gradient(135deg,#00C2E8,#0A6CF0 55%,#6A0DFF);
  color-scheme:light;
  box-sizing:border-box; padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0A1220; --bg2:#101A2D; --card:#0F1828; --ink:#EAF0FB; --ink2:#9FB0CA; --line:#22304A;
    --bk:#F7A23A; --bk-ink:#FFB866; --bk-bg:#2A1D0C; --bk-line:#5A3A12;
    --sw:#7C86FF; --sw-ink:#A9B0FF; --sw-bg:#141B3A; --sw-line:#2C3670;
    --gr:#34C77B; --ok:#34C77B; --warn-bg:#3A2D08; --warn-ink:#FFD98A;
    --shadow:0 1px 2px rgba(0,0,0,.4),0 8px 24px rgba(0,0,0,.35);
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0A1220; --bg2:#101A2D; --card:#0F1828; --ink:#EAF0FB; --ink2:#9FB0CA; --line:#22304A;
  --bk:#F7A23A; --bk-ink:#FFB866; --bk-bg:#2A1D0C; --bk-line:#5A3A12;
  --sw:#7C86FF; --sw-ink:#A9B0FF; --sw-bg:#141B3A; --sw-line:#2C3670;
  --gr:#34C77B; --ok:#34C77B; --warn-bg:#3A2D08; --warn-ink:#FFD98A;
  --shadow:0 1px 2px rgba(0,0,0,.4),0 8px 24px rgba(0,0,0,.35);
  color-scheme:dark;
}
html{height:100%;scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:'Poppins','Noto Sans Devanagari','Mukta',system-ui,-apple-system,'Segoe UI',sans-serif;font-size:14px;line-height:1.55;-webkit-text-size-adjust:100%}
button{font:inherit;color:inherit;cursor:pointer}
h1,h2,h3,h4,p{margin:0}
:focus-visible{outline:2px solid var(--sw);outline-offset:2px}
.wrap{max-width:1340px;margin:0 auto;padding:20px 16px 56px}

/* header */
.top{display:flex;flex-wrap:wrap;gap:16px 24px;align-items:center;justify-content:space-between;margin-bottom:18px}
.brandrow{display:flex;flex-wrap:wrap;align-items:center;gap:12px 16px;min-width:0}
.brandrow>div:last-child{flex:1 1 240px;min-width:0}
.logos{display:flex;align-items:center;gap:14px;background:#fff;border:1px solid var(--line);border-radius:14px;padding:8px 14px;flex:none}
.logos img{height:34px;width:auto;display:block}
.logos .sep{width:1px;height:26px;background:#DDE3EE}
h1{font-size:clamp(18px,2.6vw,26px);font-weight:700;letter-spacing:-.015em;line-height:1.25}
.sub{color:var(--ink2);font-size:13px;margin-top:2px}
.stats{display:flex;flex-wrap:wrap;gap:10px;align-items:center}
.stat{background:var(--bg2);border-radius:10px;padding:7px 12px;font-size:12.5px;color:var(--ink2);white-space:nowrap}
.stat b{color:var(--ink);font-weight:600}
.bar{display:inline-block;vertical-align:middle;width:70px;height:6px;border-radius:3px;background:var(--line);margin-left:8px;overflow:hidden}
.bar i{display:block;height:100%;background:var(--ok);border-radius:3px}
.iconbtn{border:1px solid var(--line);background:var(--card);border-radius:10px;padding:7px 12px;font-size:12.5px;color:var(--ink2)}
.iconbtn:hover{border-color:var(--ink2)}

/* tabs + filters */
.bar2{display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;margin-bottom:16px}
.tabs{display:flex;gap:4px;background:var(--bg2);padding:4px;border-radius:12px;max-width:100%;overflow-x:auto}
.tab{border:0;background:transparent;padding:8px 16px;border-radius:9px;font-weight:500;color:var(--ink2);white-space:nowrap}
@media (max-width:520px){.tab{padding:8px 11px}}
.tab[aria-selected="true"]{background:var(--card);color:var(--ink);box-shadow:var(--shadow);font-weight:600}
.filters{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.fbtn{border:1px solid var(--line);background:var(--card);border-radius:999px;padding:5px 13px;font-size:12.5px;color:var(--ink2);display:inline-flex;align-items:center;gap:6px}
.fbtn[aria-pressed="true"]{color:var(--ink);border-color:var(--ink);font-weight:600}
.dot{width:9px;height:9px;border-radius:50%;display:inline-block}
.dot.besk{background:var(--bk)} .dot.swab{background:var(--grad)}

/* layout */
.layout{display:grid;grid-template-columns:minmax(0,1fr);gap:20px}
@media (min-width:1040px){.layout{grid-template-columns:minmax(0,1fr) 460px;align-items:start}}

/* calendar */
.cal{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));border:1px solid var(--line);border-radius:14px;overflow:hidden;background:var(--card)}
.dow{background:var(--bg2);padding:8px 6px;text-align:center;font-size:12px;font-weight:600;color:var(--ink2);border-bottom:1px solid var(--line)}
.cell{position:relative;min-height:112px;padding:6px 6px 22px;border:0;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--card);text-align:left;display:flex;flex-direction:column;gap:3px;align-items:stretch;color:var(--ink)}
.cell:nth-child(7n){border-right:0}
.cell:hover{background:var(--bg2)}
.cell.out{background:var(--bg2)}
.cell.out .dn{color:var(--ink2);opacity:.7}
.cell.sel{box-shadow:inset 0 0 0 2px var(--ink);z-index:1}
.cell.today .dn{background:var(--ink);color:var(--bg);border-radius:6px;padding:0 6px}
.dn{font-weight:600;font-size:12.5px;align-self:flex-start;line-height:1.5}
.chip{display:flex;align-items:center;gap:5px;font-size:11px;line-height:1.3;padding:2px 5px;border-radius:5px;border-left:3px solid;overflow:hidden;min-width:0}
.chip b{font-weight:700;flex:none}
.chip i{font-style:normal;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chip.besk{background:var(--bk-bg);border-color:var(--bk)}
.chip.swab{background:var(--sw-bg);border-color:var(--sw)}
.chip.fest b{color:var(--bk-ink)}
.fp{font-size:10.5px;font-weight:600;color:var(--bk-ink);line-height:1.3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.fp.story{color:var(--ink2);font-weight:500}
.fp.skip{color:var(--ink2);font-weight:400;text-decoration:line-through;text-decoration-color:var(--line)}
.cnt{position:absolute;right:6px;bottom:4px;font-size:10.5px;color:var(--ink2)}
.cnt.alldone{color:var(--ok);font-weight:600}
.legend{display:flex;flex-wrap:wrap;gap:6px 16px;margin-top:10px;font-size:12px;color:var(--ink2)}
.legend span b{font-weight:700;color:var(--ink)}
@media (max-width:760px){
  .cell{min-height:66px;padding:5px 4px 18px;gap:2px}
  .chip{padding:1px 4px;justify-content:center}
  .chip i{display:none}
  .fp{display:none}
  .cell .fdot{display:block}
}
.fdot{display:none;width:6px;height:6px;border-radius:50%;background:var(--bk);align-self:flex-start}

/* side panel */
.panel{background:var(--card);border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow)}
@media (min-width:1040px){.panel{position:sticky;top:16px;max-height:calc(100vh - 32px);overflow:auto}}
@media (max-width:1039px){
  .panel{display:none}
  .panel.open{display:block;position:fixed;inset:0;z-index:50;border-radius:0;overflow:auto;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
}
.ph{padding:16px 18px 12px;border-bottom:1px solid var(--line);display:flex;gap:12px;justify-content:space-between;align-items:flex-start}
.ph h2{font-size:18px;font-weight:700;letter-spacing:-.01em}
.ph .meta{font-size:12.5px;color:var(--ink2);margin-top:3px}
.closebtn{display:none;border:1px solid var(--line);background:var(--card);border-radius:10px;padding:6px 12px;font-size:13px}
@media (max-width:1039px){.closebtn{display:inline-block}}
.fnote{margin:12px 18px 0;padding:10px 12px;border-radius:10px;background:var(--bk-bg);border:1px solid var(--bk-line);font-size:13px}
.fnote.skip{background:var(--bg2);border-color:var(--line);color:var(--ink2)}
.fnote b{font-weight:600}
.empty{padding:28px 18px;color:var(--ink2);font-size:13.5px}
.pb{margin:14px 14px 0;border:1px solid var(--line);border-radius:12px;overflow:hidden;background:var(--card)}
.pb.besk{border-top:3px solid var(--bk)}
.pb.swab{border-top:3px solid var(--sw)}
.pb:last-child{margin-bottom:14px}
.pbh{padding:12px 14px 8px}
.tags{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:6px}
.tag{font-size:11px;font-weight:600;padding:1px 8px;border-radius:999px;background:var(--bg2);color:var(--ink2)}
.tag.besk{background:var(--bk-bg);color:var(--bk-ink)}
.tag.swab{background:var(--sw-bg);color:var(--sw-ink)}
.tag.live{background:var(--ink);color:var(--bg)}
.tag.fill{background:var(--warn-bg);color:var(--warn-ink)}
.pbh h4{font-size:15px;font-weight:600;line-height:1.4}
.tasks{list-style:none;margin:0;padding:0 14px 10px}
.tasks li{display:flex;gap:10px;align-items:flex-start;padding:7px 0;border-top:1px dashed var(--line)}
.tasks label{display:flex;gap:10px;align-items:flex-start;flex:1;cursor:pointer;min-width:0}
.tasks input{margin-top:3px;width:17px;height:17px;accent-color:var(--ok);flex:none}
.tasks .tt{flex:1}
.tasks li.done .tt{text-decoration:line-through;color:var(--ink2)}
.role{font-size:11px;color:var(--ink2);background:var(--bg2);border-radius:6px;padding:1px 7px;flex:none;white-space:nowrap}
details.ct{border-top:1px solid var(--line);background:var(--bg2)}
details.ct>summary{cursor:pointer;padding:10px 14px;font-weight:600;font-size:13px;list-style:none;display:flex;justify-content:space-between;align-items:center}
details.ct>summary::-webkit-details-marker{display:none}
details.ct>summary::after{content:"+";font-weight:500;font-size:18px;color:var(--ink2);line-height:1}
details.ct[open]>summary::after{content:"–"}
.cbody{padding:2px 14px 16px;display:flex;flex-direction:column;gap:14px}
.sec h5{margin:0 0 5px;font-size:11.5px;font-weight:600;color:var(--ink2);letter-spacing:.02em}
.sec .row{display:flex;gap:8px;justify-content:space-between;align-items:center;margin-bottom:5px}
.sec .row h5{margin:0}
.txt{white-space:pre-line;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:10px 12px;font-size:13.5px}
.hook{font-size:15px;font-weight:600;background:var(--card);border-left:3px solid var(--ink);padding:8px 12px;border-radius:0 8px 8px 0}
.cpy{border:1px solid var(--line);background:var(--card);border-radius:8px;padding:3px 10px;font-size:12px;color:var(--ink2)}
.cpy:hover{border-color:var(--ink);color:var(--ink)}
.beat{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:9px 12px;margin-bottom:7px;display:grid;grid-template-columns:62px 1fr;gap:4px 10px;font-size:13px}
.beat .tm{font-weight:700;font-size:12px;color:var(--ink);grid-row:span 3}
.beat .ln b{font-weight:600;color:var(--ink2);font-size:11.5px;margin-right:4px}
.slide{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:9px 12px;margin-bottom:7px;display:grid;grid-template-columns:30px 1fr;gap:10px;font-size:13px}
.slide .n{font-weight:700;color:var(--ink2);font-size:12px;padding-top:2px}
.slide .h{font-weight:600;font-size:14px;line-height:1.4}
.slide .s{white-space:pre-line;color:var(--ink2);margin-top:2px}
mark.fill{background:var(--warn-bg);color:var(--warn-ink);border-radius:3px;padding:0 3px;font-weight:500}
.kv{display:grid;grid-template-columns:96px 1fr;gap:3px 10px;font-size:13px}
.kv dt{color:var(--ink2);font-size:12px}
.kv dd{margin:0}

/* work list */
.work{max-width:860px}
.wd{margin-bottom:14px;border:1px solid var(--line);border-radius:12px;background:var(--card);overflow:hidden}
.wdh{display:flex;justify-content:space-between;gap:10px;align-items:center;padding:10px 14px;background:var(--bg2);border-bottom:1px solid var(--line)}
.wdh b{font-weight:600}
.wdh button{border:0;background:transparent;color:var(--sw-ink);font-size:12.5px;font-weight:500;padding:2px 4px}
.wlist{list-style:none;margin:0;padding:4px 14px}
.wlist li{display:flex;gap:10px;align-items:flex-start;padding:8px 0;border-top:1px dashed var(--line)}
.wlist li:first-child{border-top:0}
.wlist label{display:flex;gap:10px;align-items:flex-start;flex:1;cursor:pointer}
.wlist input{margin-top:3px;width:17px;height:17px;accent-color:var(--ok);flex:none}
.wlist li.done .tt{text-decoration:line-through;color:var(--ink2)}
.wl-post{font-size:12px;color:var(--ink2);margin-top:1px}

/* festivals + plan */
.card{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px 18px;margin-bottom:14px}
.card h3{font-size:16px;font-weight:700;margin-bottom:8px;letter-spacing:-.01em}
.card p{margin-bottom:8px}
.card ul,.card ol{margin:0 0 4px;padding-left:20px}
.card li{margin-bottom:4px}
.fgrid{display:grid;gap:10px}
.frow{display:grid;grid-template-columns:130px minmax(0,1fr) 92px;gap:6px 14px;padding:12px 14px;border:1px solid var(--line);border-radius:12px;background:var(--card);align-items:start}
@media (max-width:700px){.frow{grid-template-columns:1fr}}
.frow .fd{font-weight:600}
.frow .fd small{display:block;color:var(--ink2);font-weight:400}
.frow .fn b{font-weight:600}
.frow .fn small{display:block;color:var(--ink2)}
.badge{display:inline-block;font-size:11.5px;font-weight:600;padding:2px 10px;border-radius:999px;background:var(--bg2);color:var(--ink2);justify-self:start}
.badge.post{background:var(--bk-bg);color:var(--bk-ink)}
.tbl{width:100%;border-collapse:collapse;font-size:12.5px}
.tbl th,.tbl td{border:1px solid var(--line);padding:6px 8px;text-align:center}
.tbl th{background:var(--bg2);font-weight:600}
.tbl td:first-child,.tbl th:first-child{text-align:left;font-weight:600}
.scroll{overflow-x:auto}
.dm{white-space:pre-line;background:var(--bg2);border:1px solid var(--line);border-radius:10px;padding:10px 12px;font-size:13px;margin:6px 0 10px}
.addt{margin:12px 14px 0;border:1px dashed var(--line);border-radius:12px;background:var(--bg2)}
.addt>summary{cursor:pointer;padding:10px 14px;font-weight:600;font-size:13px;list-style:none}
.addt>summary::-webkit-details-marker{display:none}
.addbody{padding:2px 14px 14px;display:flex;flex-direction:column;gap:8px}
.inp{width:100%;font:inherit;font-size:13.5px;color:var(--ink);background:var(--card);border:1px solid var(--line);border-radius:10px;padding:8px 10px}
textarea.inp{resize:vertical}
.two{display:grid;grid-template-columns:1fr 1fr;gap:8px}
@media (max-width:480px){.two{grid-template-columns:1fr}}
@media (max-width:760px){.inp{font-size:16px}}
.addbtn{align-self:flex-start;border:0;background:var(--ink);color:var(--bg);border-radius:10px;padding:8px 16px;font-weight:600;font-size:13px}
.hint{font-size:12px;color:var(--ink2)}
.delt{border:0;background:transparent;color:var(--ink2);font-size:14px;padding:0 4px;line-height:1;flex:none}
.delt:hover{color:var(--ink)}
.pb.mine{border-top:3px solid var(--ink)}
#toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%) translateY(20px);background:var(--ink);color:var(--bg);padding:8px 16px;border-radius:10px;font-size:13px;opacity:0;pointer-events:none;transition:opacity .2s,transform .2s;z-index:80}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
body.lock{overflow:hidden}
@media (prefers-reduced-motion:reduce){#toast{transition:none}}
</style>
</head>
