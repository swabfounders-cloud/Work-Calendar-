  const opts = '<option value="">कोणत्याही post शी जोडू नका</option>' + ids.map(id => {
    const p = POST_BY_ID[id];
    return '<option value="' + id + '"' + (state.draft.post === id ? ' selected' : '') + '>' + esc(AC[p.acct].n + ' · ' + p.title.slice(0, 42)) + '</option>';
  }).join('');
  const ac = state.draft.acct;
  return '<details class="addt" data-add="1"' + (state.addOpen ? ' open' : '') + '><summary>+ या दिवसासाठी Task add करा</summary><div class="addbody">' +
    '<input id="addtext" class="inp" type="text" maxlength="200" placeholder="काय करायचं आहे? उदा. Founder शी reel बद्दल बोला" value="' + esc(state.draft.text) + '">' +
    '<div class="two"><input id="addwho" class="inp" type="text" maxlength="40" placeholder="कोणाचं काम? (optional)" value="' + esc(state.draft.who) + '">' +
    '<select id="addacct" class="inp" aria-label="Account"><option value=""' + (ac === '' ? ' selected' : '') + '>दोन्ही accounts</option><option value="besk"' + (ac === 'besk' ? ' selected' : '') + '>फक्त BeSK</option><option value="swab"' + (ac === 'swab' ? ' selected' : '') + '>फक्त Swab</option></select></div>' +
    (ids.length ? '<select id="addpost" class="inp" aria-label="Post">' + opts + '</select>' : '') +
    '<button class="addbtn" data-addtask="1">Task add करा</button>' +
    '<p class="hint">' + (DBREF ? 'हे task team ला दिसेल (ज्यांना edit access आहे). Access नसल्यास फक्त या device वर save होईल.' : 'हे task फक्त या device/browser मध्ये save होईल. दुसऱ्याला द्यायचं असेल तर Work list मधून Export करा.') + '</p></div></details>';
}

function renderPanelHTML(){
  const d = state.sel;
  const S = DATES[d] || { posts:[], tasks:[] };
  const tasks = tasksOn(d).filter(visT);
  const livePosts = S.posts.filter(vis);
  const done = tasks.filter(t => isDone(t.id)).length;
  const ids = idsForDate(d);
  const mine = tasks.filter(t => !t.post || !POST_BY_ID[t.post]);
  let h = '<div class="ph"><div><h2>' + esc(dlabel(d)) + '</h2><div class="meta">' + livePosts.length + ' post live • ' + done + '/' + tasks.length + ' कामं पूर्ण' + (d === TODAY ? ' • आज' : '') + '</div></div><button class="closebtn" data-close="1">बंद करा</button></div>';
  (FEST_BY[d] || []).forEach(f => {
    h += '<div class="fnote' + (f.a === 'Skip' ? ' skip' : '') + '"><b>' + esc(f.n) + '</b> — ' + esc(f.a) + (f.w && f.w !== '—' ? ': ' + esc(f.w) : '') + '<br>' + esc(f.note) + '</div>';
  });
  h += addFormHTML(d, ids);
  if (mine.length){
    h += '<article class="pb mine"><div class="pbh"><div class="tags"><span class="tag">माझी कामं</span></div></div><ul class="tasks">' + mine.map(taskRow).join('') + '</ul></article>';
  }
  if (!ids.length && !mine.length){
    h += '<div class="empty">या दिवशी plan केलेला कोणताही post किंवा काम नाही. वर Task add करता येईल.</div>';
    return h;
  }
  ids.forEach(id => { h += postBlock(POST_BY_ID[id], d, tasks.filter(t => t.post === id)); });
  return h;
}

function shareCardHTML(){
  return '<div class="card"><h3>Tasks इतरांसोबत share / backup करा</h3><p>तुम्ही add केलेली कामं आणि पूर्ण झालेले ✓ एका code मध्ये copy करून WhatsApp वर पाठवता येतात. दुसरी व्यक्ती तो code खाली paste करून Import करेल.</p>' +
    '<button class="addbtn" data-export="1">Export code copy करा</button>' +
    (state.exportCode ? '<textarea class="inp" rows="3" readonly data-selectall="1" style="margin-top:8px">' + esc(state.exportCode) + '</textarea>' : '') +
    '<div class="sec" style="margin-top:14px"><h5>Import</h5><textarea id="impbox" class="inp" rows="3" placeholder="इथे दुसऱ्याने पाठवलेला code paste करा">' + esc(state.impText) + '</textarea><div style="margin-top:8px"><button class="addbtn" data-import="1">Import करा</button></div></div></div>';
}
function renderWork(){
  const all = allTasks().filter(t => visT(t) && (!state.pending || !isDone(t.id)));
  const pdt = t => (POST_BY_ID[t.post] || {}).date || '';
  all.sort((a, b) => a.date < b.date ? -1 : a.date > b.date ? 1 : (pdt(a) < pdt(b) ? -1 : pdt(a) > pdt(b) ? 1 : 0));
  let h = '<div class="work">' + shareCardHTML();
  if (!all.length) return h + '<div class="card"><p>कोणतंही pending काम नाही. सगळं पूर्ण!</p></div></div>';
  const groups = [];
  all.forEach(t => {
    let g = groups[groups.length - 1];
    if (!g || g.d !== t.date){ g = { d:t.date, items:[] }; groups.push(g); }
    g.items.push(t);
  });
  groups.forEach(g => {
    h += '<section class="wd"><div class="wdh"><b>' + esc(dlabel(g.d)) + (g.d === TODAY ? ' • आज' : '') + '</b><button data-open="' + g.d + '">Calendar मध्ये Content उघडा</button></div><ul class="wlist">';
    g.items.forEach(t => {
      const p = POST_BY_ID[t.post];
      const dn = isDone(t.id);
      const sub = p ? AC[p.acct].n + ' · ' + FM[p.fmt].l + ' · ' + esc(p.title) + ' · Post: ' + dshort(p.date) : 'माझं task';
      h += '<li class="' + (dn ? 'done' : '') + '"><label><input type="checkbox" data-task="' + esc(t.id) + '"' + (dn ? ' checked' : '') + '><span><span class="tt">' + esc(t.text) + '</span><div class="wl-post">' + sub + '</div></span></label>' +
        (t.who ? '<span class="role">' + esc(t.who) + '</span>' : '') +
        (isCustom(t) ? '<button class="delt" data-deltask="' + esc(t.id) + '" aria-label="Task काढा">✕</button>' : '') + '</li>';
    });
    h += '</ul></section>';
  });
  return h + '</div>';
}

