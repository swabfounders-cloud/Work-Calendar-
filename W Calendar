  FESTS.forEach(f => {
    h += '<div class="frow"><div class="fd">' + esc(dlabel(f.d)) + '</div><div class="fn"><b>' + esc(f.n) + '</b><small>' + esc(f.w && f.w !== '—' ? f.w : 'कोणताही post नाही') + '</small><small>' + esc(f.note) + '</small></div><span class="badge ' + (f.a === 'Post' ? 'post' : '') + '">' + esc(f.a) + '</span></div>';
  });
  return h + '</div></div>';
}

